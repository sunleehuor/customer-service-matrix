{
  "name": "matrix-customer-service-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run format",
    "build": "vue-tsc -b && vite build",
    "prebuild": "npm run format",
    "preview": "vite preview",
    "eslint": "npx eslint .",
    "format": "prettier --write \"src/**/*.{ts,js,vue,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,vue,json,css}\"",
    "t": "npx lee-tr t",
    "sync": "npx lee-tr sync",
    "prepare": "husky"
  },
  "dependencies": {
    "@lucide/vue": "^1.72.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/vue-query": "^5.107.1",
    "@tanstack/vue-virtual": "^3.13.52",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "matrix-js-sdk": "^45.1.0",
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.19",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lee-tr-cli": "^1.1.3",
    "prettier": "3.10.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14"
  },
  "lee-tr": {
    "configPath": "./src/common/locales/config.json"
  }
}
